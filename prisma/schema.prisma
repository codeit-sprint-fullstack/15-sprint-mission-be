generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Product{
    id Int @id @default(autoincrement())
    name String
    description String
    price Int
    tags String[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("products")
}