  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.9.4"
  }
