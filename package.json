{
  "name": "panda-market-server",
  "version": "1.0.0",
  "description": "fs-15-sprint5-server",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#generated/*": "./generated/*",
    "#config": "./src/config/config.js",
    "#db/*": "./src/db/*",
    "#constants": "./src/constants/index.js",
    "#errors": "./src/errors/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#repositories": "./src/repositories/index.js",
    "#utils": "./src/utils/index.js"
  },
  "scripts": {
    "dev": "node --env-file=./env/.env.development --watch src/server.js",
    "dev:clean": "lsof -ti:5001 | xargs kill -9 2>/dev/null; npm run dev",
    "prisma:generate": "dotenv -e ./env/.env.development -- npx prisma generate",
    "prisma:migrate": "dotenv -e ./env/.env.development -- npx prisma migrate dev",
    "prisma:studio": "dotenv -e ./env/.env.development -- npx prisma studio",
    "seed": "node --env-file=./env/.env.development src/scripts/seed.js --allow-reset=panda_market_db",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "prisma": "^7.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  }
}
