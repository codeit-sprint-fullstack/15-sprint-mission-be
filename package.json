{
  "name": "sprint-mission6-be",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "imports": {
    "#generated/*": "./generated/*",
    "#config": "./src/config/config.js",
    "#db/*": "./src/db/*",
    "#constants": "./src/constants/index.js",
    "#errors": "./src/errors/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#repositories": "./src/repositories/index.js",
    "#utils": "./src/utils/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "prod": "cross-env node --env-file=./env/.env.production dist/src/server.js",
    "dev": "cross-env  node --env-file=./env/.env.development --watch src/server.js",
    "prisma:generate": "dotenv -e ./env/.env.development -- npx prisma generate",
    "prisma:migrate": "dotenv -e ./env/.env.development -- npx prisma migrate dev",
    "prisma:studio": "dotenv -e ./env/.env.development -- npx prisma studio",
    "seed": "node --env-file=./env/.env.development ./scripts/seed.js --allow-reset=sprint_mission_6_db",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1"
  }
}
