{
  "name": "panda-market-server",
  "version": "1.0.0",
  "description": "fs-15-sprint5-server",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=./env/.env.development --watch src/server.js",
    "dev:clean": "lsof -ti:5001 | xargs kill -9 2>/dev/null; npm run dev",
    "seed": "node --env-file=./env/.env.development src/scripts/dataSeed.js",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  }
}
