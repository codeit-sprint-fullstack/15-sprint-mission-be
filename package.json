  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#generated/*": "./generated/*"
  },
  "bugs": {
    "url": "https://github.com/thcjfd/15-sprint-mission-be/issues"
  },
  "homepage": "https://github.com/thcjfd/15-sprint-mission-be#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
