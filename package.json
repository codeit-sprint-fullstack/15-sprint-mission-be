  "main": "index.js",
  "scripts": {
    "dev": "nodemon --env-file=./env/.env.development ./src/server.js",
    "prisma:generate": "dotenv -e ./env/.env.development -- npx prisma generate",
    "prisma:migrate": "dotenv -e ./env/.env.development -- npx prisma migrate dev",
    "seed": "node --env-file=./env/.env.development scripts/seed.js --allow-reset=sprint_mission",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node src/server.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thcjfd/15-sprint-mission-be.git"
  },
  "keywords": [],
